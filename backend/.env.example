# ============================================================
# Configurações da Automação Jira
# ============================================================
# Copie este arquivo para .env e preencha com os valores corretos
#   cp .env.example .env

# URL do Jira Server/DC (sem barra no final)
JIRA_URL=https://jira-la.secext.samsung.net

# ============================================================
# Confluence (opcional - publicação de auditorias)
# Se não definidos, são usados os padrões do confluence_client.py
# ============================================================
# URL do Confluence Server/DC (sem barra no final)
# CONFLUENCE_URL=https://confluence-la.secext.samsung.net

# Espaço onde a página da auditoria será publicada
# CONFLUENCE_SPACE_KEY=BXBNG

# ID da página pai (Service Delivery Review)
# CONFLUENCE_PARENT_ID=404561599

# Porta do servidor Flask (padrão: 5000)
FLASK_PORT=5000

# NOTA: O token de cada usuário NÃO fica aqui.
# Cada usuário faz login com seu próprio Personal Access Token no navegador.
# O token é salvo no localStorage do navegador (não no servidor).
